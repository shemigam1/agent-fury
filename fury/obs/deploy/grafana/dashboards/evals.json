{
  "uid": "fury-evals",
  "title": "agent-fury · Evals",
  "tags": ["agent-fury", "evals"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Success rate by model",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 2 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "targets": [
        { "refId": "A", "legendFormat": "{{model}}", "expr": "sum by (model) (fury_eval_tasks_total{result=\"pass\"}) / clamp_min(sum by (model) (fury_eval_tasks_total), 1)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Pass vs fail",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "legendFormat": "{{result}}", "expr": "sum by (result) (fury_eval_tasks_total)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tasks run",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(fury_eval_tasks_total)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Total eval cost by model (USD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic" },
      "targets": [
        { "refId": "A", "legendFormat": "{{model}}", "expr": "sum by (model) (fury_eval_cost_total)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Avg iterations / task by model",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic" },
      "targets": [
        { "refId": "A", "legendFormat": "{{model}}", "expr": "sum by (model) (fury_eval_iterations_sum) / clamp_min(sum by (model) (fury_eval_iterations_count), 1)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Avg duration / task by model (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "basic" },
      "targets": [
        { "refId": "A", "legendFormat": "{{model}}", "expr": "sum by (model) (fury_eval_duration_sum) / clamp_min(sum by (model) (fury_eval_duration_count), 1)", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ]
}
